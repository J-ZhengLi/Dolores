{
  "openapi": "3.1.0",
  "info": {
    "title": "Dolores desktop shell contracts",
    "version": "0.1.0",
    "description": "No HTTP API. Selected Flutter shell uses the in-process C ABI in x-flutter-ffi. x-tauri-commands describes alternative Tauri IPC; Iced uses internal Rust events."
  },
  "paths": {},
  "x-flutter-ffi": {
    "abiVersion": 1,
    "transport": "in-process C ABI, UTF-8 JSON",
    "call": {
      "symbol": "dolores_call",
      "signature": "char *(const uint8_t *input, size_t length)",
      "maxRequestBytes": 131072,
      "result": "{ok:true,result:any} or {ok:false,error:string}"
    },
    "free": {
      "symbol": "dolores_free",
      "signature": "void(char *result)",
      "ownership": "Free each live dolores_call result exactly once; null allowed."
    },
    "commands": {
      "bootstrap": {
        "arguments": {},
        "result": "{sessions,preferences:{baseUrl,model},enabledModels:string[],configured:boolean,rememberConnection:boolean,hasSavedKey:boolean,connectionWarning:string|null,plugins:[storage,credentials]}"
      },
      "messages": {
        "arguments": { "session": "string" },
        "result": "Message[0..80]"
      },
      "delete": { "arguments": { "session": "string" }, "result": "null" },
      "configure": {
        "arguments": {
          "preferences": "{baseUrl:string,model:string}",
          "apiKey": "string|null; optional; null/omitted reuses active/saved key only for same endpoint, or empty if none",
          "rememberConnection": "boolean; optional; default false; true stores key in OS credential store",
          "enabledModels": "string[]; optional; 1..32 valid IDs including active model; defaults to [preferences.model]"
        },
        "result": "null"
      },
      "recoverConnection": {
        "arguments": {},
        "result": "null; reload saved connection; failure clears provider and sets connectionWarning"
      },
      "listModels": {
        "arguments": {"baseUrl": "string; validated endpoint prefix", "apiKey": "string|null; optional; same-endpoint reuse only"},
        "result": "string[]; sorted unique valid IDs from GET <baseUrl>/models; 20-second timeout, 1 MiB response and 512-entry caps; no configuration changes"
      },
      "selectModel": {
        "arguments": {"model": "string; must be enabled"},
        "result": "null; persist active model/metadata atomically, preserve key and history"
      },
      "forgetConnection": {
        "arguments": {},
        "result": "null; deletes saved key/reference and active connection, preserves history/preferences"
      },
      "start": {
        "arguments": {
          "id": "u64",
          "session": "string|null",
          "input": "string"
        },
        "result": "null; reservation acknowledged"
      },
      "poll": {
        "arguments": { "id": "u64" },
        "result": "Event[0..32]; stale IDs return []"
      },
      "cancel": {
        "arguments": { "id": "u64" },
        "result": "null; stale IDs are a no-op"
      },
      "shutdown": {
        "arguments": {},
        "result": "null; cancels active run, preserves process-wide engine"
      }
    },
    "events": [
      "{type:started,id,session}",
      "{type:delta,id,text}",
      "{type:done,id,answer}",
      "{type:done,id,error}"
    ],
    "busy": "Only poll, cancel and shutdown are accepted until the terminal event is drained.",
    "documentation": "flutter/flutter-api.md"
  },
  "x-tauri-commands": {
    "bootstrap": {
      "arguments": {},
      "result": { "$ref": "#/components/schemas/Bootstrap" }
    },
    "create_session": {
      "arguments": {},
      "result": { "$ref": "#/components/schemas/Session" }
    },
    "get_messages": {
      "arguments": { "sessionId": { "type": "string", "format": "uuid" } },
      "result": {
        "type": "array",
        "maxItems": 80,
        "items": { "$ref": "#/components/schemas/Message" }
      }
    },
    "delete_session": {
      "arguments": { "sessionId": { "type": "string", "format": "uuid" } },
      "result": { "type": "null" }
    },
    "configure_connection": {
      "arguments": {
        "preferences": { "$ref": "#/components/schemas/Preferences" },
        "apiKey": {
          "type": "string",
          "writeOnly": true,
          "description": "Required argument, may be empty; at most 4096 UTF-8 bytes, no CR/LF; replaces the in-memory credential."
        }
      },
      "result": { "type": "null" }
    },
    "generate": {
      "arguments": {
        "sessionId": { "type": "string", "format": "uuid" },
        "runId": { "type": "string", "format": "uuid" },
        "input": {
          "type": "string",
          "description": "Nonblank, at most 16384 UTF-8 bytes."
        },
        "onEvent": { "x-tauri-type": "Channel<DeltaEvent>" }
      },
      "result": { "type": "null" },
      "channel": { "$ref": "#/components/schemas/DeltaEvent" }
    },
    "cancel_run": {
      "arguments": { "runId": { "type": "string", "format": "uuid" } },
      "result": { "type": "null" }
    }
  },
  "x-error-result": {
    "type": "string",
    "description": "Invocation rejection with a user-facing error; no stable error codes in v1."
  },
  "components": {
    "schemas": {
      "Message": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["user", "assistant", "system"] },
          "content": { "type": "string" }
        }
      },
      "Session": {
        "type": "object",
        "required": ["id", "title", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "updatedAt": {
            "type": "integer",
            "description": "Unix milliseconds."
          }
        }
      },
      "Preferences": {
        "type": "object",
        "required": ["baseUrl", "model"],
        "properties": {
          "baseUrl": {
            "type": "string",
            "format": "uri",
            "description": "At most 2048 UTF-8 bytes; HTTPS or HTTP loopback, no userinfo/query/fragment."
          },
          "model": {
            "type": "string",
            "description": "Nonblank, at most 200 UTF-8 bytes, no control characters."
          }
        }
      },
      "Plugin": {
        "type": "object",
        "required": ["id", "kind", "apiVersion"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["provider", "storage", "credentials"] },
          "apiVersion": { "const": 1 }
        }
      },
      "Bootstrap": {
        "type": "object",
        "required": ["sessions", "preferences", "connected", "plugins"],
        "properties": {
          "sessions": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/Session" }
          },
          "preferences": { "$ref": "#/components/schemas/Preferences" },
          "connected": {
            "type": "boolean",
            "description": "Configured, not network-tested."
          },
          "plugins": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Plugin" }
          }
        }
      },
      "DeltaEvent": {
        "type": "object",
        "description": "First event has an empty delta acknowledging native run reservation; subsequent events contain ordered plain text.",
        "required": ["runId", "delta"],
        "properties": {
          "runId": { "type": "string", "format": "uuid" },
          "delta": { "type": "string" }
        }
      }
    }
  }
}
